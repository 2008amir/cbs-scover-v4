{
  "name": "ELITE-PRO-V1",
  "version": "1.1.1",
  "description": "A WhatsApp bot with rich features.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "postinstall": "node scripts/patch-baileys-single-tick.js",
    "start": "node index.js",
    "dev": "node -e \"const http=require('http'),fs=require('fs');const html=fs.readFileSync('lib/index.html');http.createServer((q,s)=>{s.writeHead(200,{'Content-Type':'text/html'});s.end(html)}).listen(process.env.PORT||8080,()=>console.log('preview server ready'))\" --",
    "build:dev": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('lib/index.html','dist/index.html')\"",
    "build": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('lib/index.html','dist/index.html')\""
  },
  "author": "cyrilix",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "latest",
    "@hapi/boom": "latest",
    "@supabase/supabase-js": "^2.112.4",
    "@vitalets/google-translate-api": "^9.2.0",
    "awesome-phonenumber": "^5.9.0",
    "axios": "^1.14.0",
    "baileys": "npm:eliteprotech-baileys@1.0.9",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "file-type": "^16.5.3",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.0",
    "fs-extra": "^11.1.1",
    "gifted-btns": "^1.0.2",
    "google-tts-api": "^2.0.2",
    "human-readable": "^0.2.1",
    "jimp": "^0.16.3",
    "jsdom": "^22.1.0",
    "jsqr": "^1.4.0",
    "libphonenumber-js": "^1.12.8",
    "moment-timezone": "^0.5.43",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.6.11",
    "node-webpmux": "^3.1.7",
    "performance-now": "^2.1.0",
    "pino": "^10.1.0",
    "qrcode": "^1.5.3",
    "sharp": "^0.35.2",
    "translate-google-api": "^1.0.4",
